# Flask Application Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration (Defaults to SQLite)
DATABASE_URL=sqlite:///kartmart.db
TEST_DATABASE_URL=sqlite:///:memory:

# Alternative: MySQL Database Configuration (uncomment if using MySQL Server)
# DATABASE_URL=mysql+pymysql://root:your_db_password@127.0.0.1:3306/kartmart_db
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_db_password
# DB_NAME=kartmart_db

# Admin Provisioning & Security Keys
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_NAME=Store Administrator
ADMIN_REGISTRATION_KEY=your-admin-registration-passkey
